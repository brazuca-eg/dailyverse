---
import { SpotGame } from "../games/spot-difference/SpotGame";
import { SPOT_LAUNCH_DATE } from "../games/spot-difference/daily";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Spot the Difference – Dailyverse"
  description="Find the five differences between two outdoor scenes. A new puzzle every day."
  wide
>
  <Fragment slot="hero">
    <h1>Spot the Difference</h1>
    <p class="lead">Five things changed. Can you find them all?</p>
  </Fragment>
  <SpotGame client:only="react" launchDate={SPOT_LAUNCH_DATE} />
</BaseLayout>
