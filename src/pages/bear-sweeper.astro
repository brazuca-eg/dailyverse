---
import { BearSweeperGame } from "../games/bear-sweeper/BearSweeperGame";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Bear Sweeper – Dailyverse"
  description="Find the bears hiding around your campsite using logic alone. A new puzzle every day."
>
  <Fragment slot="hero">
    <h1>Bear Sweeper</h1>
    <p class="lead">Reveal every safe square, and never wake a bear. No guessing needed.</p>
  </Fragment>
  <BearSweeperGame client:only="react" />
</BaseLayout>
