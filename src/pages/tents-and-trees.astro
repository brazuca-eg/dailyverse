---
import { TentsGame } from "../games/tents-trees/TentsGame";
import { TENTS_LAUNCH_DATE } from "../games/tents-trees/daily";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Tents and Trees – Dailyverse"
  description="Pitch a tent next to every tree. A new logic puzzle every day."
>
  <Fragment slot="hero">
    <h1>Tents and Trees</h1>
    <p class="lead">Pitch a tent beside every tree, without letting two touch.</p>
  </Fragment>
  <TentsGame client:only="react" launchDate={TENTS_LAUNCH_DATE} />
</BaseLayout>
