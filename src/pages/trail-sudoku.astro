---
import { SudokuGame } from "../games/trail-sudoku/SudokuGame";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Trail Sudoku – Dailyverse"
  description="A fresh Sudoku every day, from a quick 6x6 to a full 9x9."
>
  <Fragment slot="hero">
    <h1>Trail Sudoku</h1>
    <p class="lead">Fill every row, column and box. Easy 6x6 days, tough 9x9 days.</p>
  </Fragment>
  <SudokuGame client:only="react" />
</BaseLayout>
