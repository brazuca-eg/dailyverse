---
import { countries } from "../core/countries";
import { FlagGame } from "../games/flag-fragment/FlagGame";
import { FLAG_LAUNCH_DATE, flagSchedule } from "../games/flag-fragment/data";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Flag Fragment – Dailyverse"
  description="Guess the country from a fragment of its flag. A new flag every day."
>
  <Fragment slot="hero">
    <h1>Flag Fragment</h1>
    <p class="lead">Which flag is this? A wrong guess zooms out.</p>
  </Fragment>
  <FlagGame
    client:only="react"
    schedule={flagSchedule}
    countries={countries}
    launchDate={FLAG_LAUNCH_DATE}
  />
</BaseLayout>
