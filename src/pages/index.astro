---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";
---

<BaseLayout title="Dailyverse – Small daily games">
  <Fragment slot="hero">
    <h1>Small daily games</h1>
    <p class="lead">One new puzzle every day. Five minutes, tops.</p>
  </Fragment>
  <ul class="game-list">
    <li>
      <a class="game-card" href="/mystery-place">
        <span class="game-card-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="30"
            height="30"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"></path>
            <circle cx="12" cy="10" r="2.5"></circle>
          </svg>
        </span>
        <span class="game-card-body">
          <span class="game-card-title">Mystery Place</span>
          <span class="game-card-text">Guess the country from five clues.</span>
        </span>
        <span class="game-card-cta">Play</span>
      </a>
    </li>
    <li>
      <a class="game-card" href="/flag-fragment">
        <span class="game-card-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="30"
            height="30"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 21V4"></path>
            <path d="M5 4h12l-2 4 2 4H5"></path>
          </svg>
        </span>
        <span class="game-card-body">
          <span class="game-card-title">Flag Fragment</span>
          <span class="game-card-text">Name the country from a piece of its flag.</span>
        </span>
        <span class="game-card-cta">Play</span>
      </a>
    </li>
    <li>
      <a class="game-card" href="/spot-the-difference">
        <span class="game-card-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="30"
            height="30"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="m16 16 4.5 4.5"></path>
          </svg>
        </span>
        <span class="game-card-body">
          <span class="game-card-title">Spot the Difference</span>
          <span class="game-card-text">Find five changes between two scenes.</span>
        </span>
        <span class="game-card-cta">Play</span>
      </a>
    </li>
    <li>
      <a class="game-card" href="/tents-and-trees">
        <span class="game-card-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="30"
            height="30"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M3 20 12 5l9 15z"></path>
            <path d="M10 20l2-5 2 5"></path>
          </svg>
        </span>
        <span class="game-card-body">
          <span class="game-card-title">Tents and Trees</span>
          <span class="game-card-text">Pitch a tent beside every tree.</span>
        </span>
        <span class="game-card-cta">Play</span>
      </a>
    </li>
    <li>
      <a class="game-card" href="/trail-words">
        <span class="game-card-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="30"
            height="30"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 3 19 7v8l-7 4-7-4V7z"></path>
            <path d="M9.5 9.5h5v5h-5z" stroke-width="0" fill="currentColor"></path>
          </svg>
        </span>
        <span class="game-card-body">
          <span class="game-card-title">Trail Words</span>
          <span class="game-card-text">Spell as many words as you can from seven letters.</span>
        </span>
        <span class="game-card-cta">Play</span>
      </a>
    </li>
    <li>
      <a class="game-card" href="/peak-order">
        <span class="game-card-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="30"
            height="30"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 20V13"></path>
            <path d="M10 20V8"></path>
            <path d="M16 20V4"></path>
            <path d="M3 20h18"></path>
          </svg>
        </span>
        <span class="game-card-body">
          <span class="game-card-title">Peak Order</span>
          <span class="game-card-text">Rank five mountains, rivers or lakes by size.</span>
        </span>
        <span class="game-card-cta">Play</span>
      </a>
    </li>
    <li>
      <a class="game-card" href="/trail-sudoku">
        <span class="game-card-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="30"
            height="30"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <path d="M9 3v18"></path>
            <path d="M15 3v18"></path>
            <path d="M3 9h18"></path>
            <path d="M3 15h18"></path>
          </svg>
        </span>
        <span class="game-card-body">
          <span class="game-card-title">Trail Sudoku</span>
          <span class="game-card-text">A daily Sudoku, from quick 6x6 to full 9x9.</span>
        </span>
        <span class="game-card-cta">Play</span>
      </a>
    </li>
    <li>
      <a class="game-card" href="/switchback">
        <span class="game-card-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="30"
            height="30"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 5h13a3 3 0 0 1 0 6H7a3 3 0 0 0 0 6h13"></path>
            <circle cx="4" cy="5" r="1.2"></circle>
            <circle cx="20" cy="17" r="1.2"></circle>
          </svg>
        </span>
        <span class="game-card-body">
          <span class="game-card-title">Switchback</span>
          <span class="game-card-text">Wind one trail through every square.</span>
        </span>
        <span class="game-card-cta">Play</span>
      </a>
    </li>
  </ul>
</BaseLayout>
