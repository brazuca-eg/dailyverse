---
import { SwitchbackGame } from "../games/switchback/SwitchbackGame";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Switchback – Dailyverse"
  description="Draw one trail through every square, checkpoint by checkpoint. A new route every day."
>
  <Fragment slot="hero">
    <h1>Switchback</h1>
    <p class="lead">Wind one trail through every square, reaching each checkpoint in order.</p>
  </Fragment>
  <SwitchbackGame client:only="react" />
</BaseLayout>
