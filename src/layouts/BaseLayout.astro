---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/animations.css";
import "../styles/primitives.css";
import "./BaseLayout.css";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const {
  title,
  description = "Small daily games. A new puzzle every day.",
  wide = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2a7a58" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e4a3a" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="hero">
      <div class="hero-sun" aria-hidden="true"></div>
      <div class:list={["hero-inner", { "hero-inner-wide": wide }]}>
        <a href="/" class="brand" aria-label="Dailyverse home">
          <svg class="brand-mark" viewBox="0 0 32 32" width="34" height="34" aria-hidden="true">
            <rect width="32" height="32" rx="10" fill="#fbf6ec"></rect>
            <circle cx="23" cy="10" r="3.2" fill="#f2b632"></circle>
            <path d="M4 25 13 10l5 8 3-4 7 11z" fill="#1f5f46"></path>
          </svg>
          <span class="brand-name">Dailyverse</span>
        </a>
        <slot name="hero" />
      </div>
      <svg class="hero-hills" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M0 70 C120 20 240 80 380 50 S640 10 780 55 S1060 30 1200 60 V120 H0 Z"
          fill="rgba(255,255,255,0.12)"
        ></path>
        <path
          d="M0 88 C160 50 300 100 470 72 S780 40 940 80 S1120 70 1200 82 V120 H0 Z"
          fill="rgba(255,255,255,0.18)"
        ></path>
        <path d="M0 104 C200 80 340 112 560 96 S920 74 1200 102 V120 H0 Z" fill="var(--bg)"></path>
      </svg>
    </header>
    <main class:list={["page", { "page-wide": wide }]}>
      <slot />
    </main>
  </body>
</html>
